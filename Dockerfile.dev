# Dockerfile.dev

FROM python:3.13-slim-trixie

# Install a pinned uv version
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /bin/

WORKDIR /app

# Prevent uv from creating Python downloads
ENV UV_PYTHON_DOWNLOADS=0

# Use copy mode because Docker cache and /app may be different filesystems
ENV UV_LINK_MODE=copy

# Install dependencies first for better layer caching
COPY pyproject.toml uv.lock .python-version README.md ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

# Copy source code
COPY src ./src

# Install the project in editable mode for development
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["fastapi", "dev", "src/fastapi_learning_project/main.py", "--host", "0.0.0.0", "--port", "8000"]